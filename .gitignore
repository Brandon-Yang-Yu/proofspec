node_modules/
*.tsbuildinfo

# `build`'s output — the published package contents, produced by tsc on demand.
dist/

# `render`'s output — a generated site, regenerated on demand, never committed.
# Anchored to the repo root: render's default out is `build/` there, and the bare
# pattern would also hide a `tests/build/` capability from git.
/build/

# Claude Code worktrees live here; the skills beside them are committed.
.claude/worktrees/

# ProofSpec's own TASK worktrees (docs/design.md §"startSession"), one per task.
.proofspec/worktrees/

# The per-test recording `impact --coverage` reads, rewritten by every coverage run.
.proofspec-coverage.jsonl

# `dispatch`/`schedule`'s own queue: local runtime state (MANIFEST, state, LEASE) for
# in-flight TASKs, recomputed and rewritten on every schedule pass — never committed, and
# deliberately not addressable from a TASK's own branch (see docs/design.md §49).
.proofspec/dispatch/
