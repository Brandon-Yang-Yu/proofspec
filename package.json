    "proofspec": "node --experimental-transform-types src/cli/main.ts"
  },
  "dependencies": {
    "oxc-parser": "^0.141.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
