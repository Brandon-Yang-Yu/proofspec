{
  "name": "proofspec",
  "version": "0.1.0",
  "description": "A thin layer that makes your test suite the living spec",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brandon-Yang-Yu/proofspec.git"
  },
  "homepage": "https://github.com/Brandon-Yang-Yu/proofspec#readme",
  "bugs": "https://github.com/Brandon-Yang-Yu/proofspec/issues",
  "keywords": [
    "spec",
    "living-documentation",
    "gherkin",
    "bdd",
    "testing",
    "vitest"
  ],
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "proofspec": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/cli/index.js",
    "./vitest-setup": "./dist/test-run/vitest-setup.js",
    "./vitest-global": "./dist/test-run/vitest-global.js",
    "./src/*": "./src/*"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    ".claude/agents",
    ".pi/agents",
    ".pi/extensions"
  ],
  "scripts": {
    "preinstall": "node -e \"const{existsSync}=require('node:fs');const ua=process.env.npm_config_user_agent??'';if(existsSync('.githooks')&&!ua.startsWith('pnpm')){console.error('This repo uses pnpm');process.exit(1)}\"",
    "prepare": "node -e \"const{existsSync}=require('node:fs');if(existsSync('.githooks'))require('node:child_process').execSync('git config core.hooksPath .githooks')\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "test": "vitest run",
    "coverage": "vitest run -c vitest.coverage.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build",
    "proofspec": "node --experimental-transform-types src/cli/main.ts",
    "spec:check": "pnpm proofspec check",
    "spec:write": "pnpm proofspec write",
    "personas:write": "node --experimental-transform-types src/personas/main.ts write",
    "personas:check": "node --experimental-transform-types src/personas/main.ts check",
    "investigator": "pi --extension .pi/extensions/handoff.ts --append-system-prompt \"$(awk '/^---$/{n++;next} n<2{next} 1' .pi/agents/investigator.md)\"",
    "investigator:claude": "claude --mcp-config '{\"mcpServers\":{\"proofspec\":{\"command\":\"node\",\"args\":[\"--experimental-transform-types\",\"src/mcp/serve.ts\"]}}}' --append-system-prompt \"$(awk '/^---$/{n++;next} n<2{next} 1' .pi/agents/investigator.md)\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "oxc-parser": "^0.141.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
